// name: Warm pad
// category: pad
// JAUDIOS preset: synthesised (sfizz oscillators), no samples. Detuned saws, slow filter swell.
<global>
amp_veltrack=40 ampeg_attack=0.6 ampeg_decay=1.5 ampeg_sustain=80 ampeg_release=1.8
fil_type=lpf_2p cutoff=900 resonance=2 fileg_attack=0.9 fileg_sustain=45 fileg_release=1.5 fileg_depth=1500
<region> sample=*saw oscillator_multi=5 oscillator_detune=18 volume=-14
<region> sample=*saw oscillator_multi=3 oscillator_detune=10 transpose=-12 volume=-18
