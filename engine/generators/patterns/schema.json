{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jaudios/bass-pattern.schema.json",
  "title": "JAudios bass pattern",
  "description": "One looping bass rhythm. Steps sit on a grid of `grid` steps per 4/4 bar; the pattern loops every `bars` bars. Pitches come from `role`, resolved against the chord at that step (bass-generator skill).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "style", "grid", "bars", "steps"],
  "properties": {
    "name":  { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "style": { "type": "string", "enum": ["pop", "house", "techno", "trance", "lofi", "rnb", "cinematic"] },
    "description": { "type": "string" },
    "grid":  { "type": "integer", "enum": [8, 16, 32] },
    "bars":  { "type": "integer", "enum": [1, 2, 4] },
    "swing": { "type": "number", "minimum": 0, "maximum": 0.75 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "role"],
        "properties": {
          "step":     { "type": "integer", "minimum": 0, "maximum": 127 },
          "length":   { "type": "integer", "minimum": 1, "maximum": 128 },
          "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
          "gate":     { "type": "number", "minimum": 0.05, "maximum": 1.0 },
          "role":     { "type": "string", "enum": ["root", "third", "fifth", "octave", "chord", "scale", "approach"] }
        }
      }
    }
  }
}
